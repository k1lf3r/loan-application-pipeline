<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LoanApplicationPipeline\LoanApplicationPipeline.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The native binary must sit next to the test assembly for the real native-call tests. -->
  <ItemGroup>
    <None Include="..\native\bin\loanrisk.dll" Link="loanrisk.dll"
          Condition="Exists('..\native\bin\loanrisk.dll')" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\native\bin\libloanrisk.so" Link="libloanrisk.so"
          Condition="Exists('..\native\bin\libloanrisk.so')" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\native\bin\libloanrisk.dylib" Link="libloanrisk.dylib"
          Condition="Exists('..\native\bin\libloanrisk.dylib')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
